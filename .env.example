# Copy to .env and fill in. Only GEMINI_API_KEY is required for AI features.
PORT=8787

# --- LLM (Gemini-first, recommended) ---
# Free key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
LLM_PROVIDER=gemini # gemini | openai | anthropic | ollama
LLM_MODEL=gemini-2.0-flash # try gemini-1.5-flash if 2.0 is unavailable in your region

# Optional fallbacks / alternatives
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Realtime transcription (optional — overlay also has free mic mode) ---
DEEPGRAM_API_KEY=
# TRANSCRIBE_PROVIDER=deepgram # deepgram | browser | mock

# --- People enrichment (pick one — do NOT scrape LinkedIn directly) ---
PROXYCURL_API_KEY=
ROCKETREACH_API_KEY=
PEOPLE_DATA_LABS_API_KEY=

# --- Web search / realtime intel (pick at least one for live fact-checks) ---
TAVILY_API_KEY=       # recommended: https://tavily.com
BRAVE_SEARCH_API_KEY= # https://brave.com/search/api
EXA_API_KEY=          # https://exa.ai

# --- App behavior ---
MOCK_MODE=true # auto-detects; set false to hard-require keys
CONSENT_BANNER=true
