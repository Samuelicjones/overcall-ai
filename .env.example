# Copy to .env and fill in
PORT=8787

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai # openai | anthropic | ollama
LLM_MODEL=gpt-4o-mini

# Realtime transcription (pick one)
DEEPGRAM_API_KEY=
# TRANSCRIBE_PROVIDER=deepgram # deepgram | whisper-local | mock

# People enrichment (pick one — do NOT scrape LinkedIn directly)
PROXYCURL_API_KEY=
ROCKETREACH_API_KEY=
PEOPLE_DATA_LABS_API_KEY=

# Web search / realtime intel
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# App behavior
MOCK_MODE=true # set false when keys are configured
CONSENT_BANNER=true
