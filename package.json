{
  "name": "overcall-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI copilot overlay for Zoom / Meet / Teams - who they are, talking points, live fact-checks",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,overlay -c blue,green \"npm:dev --workspace=server\" \"npm:dev --workspace=@overcall/overlay\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:overlay": "npm run dev --workspace=@overcall/overlay",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --ext .ts,.tsx || true"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
